languagesystem DFLT dflt;
languagesystem arab dflt;

# Classes
feature init {
  sub Plain.eth by Plain.eth;
  sub Plain.Zcaron by Plain.Zcaron;
  sub Plain.Eth by Plain.Eth;
  sub Plain.Yacute by Plain.Yacute;
} init;

feature medi {
  sub Plain.K by Plain.K;
  sub Plain.O by Plain.O;
  sub Plain.N by Plain.N;
  sub Plain.H by Plain.H;
  sub Plain.u by Plain.u;
} medi;

feature fina {
  sub Plain.r by Plain.r;
  sub Plain.d by Plain.d;
  sub Plain.Ecircumflex by Plain.Ecircumflex;
  sub Plain.question by Plain.question;
} fina;

feature rlig {
  sub Plain.K Plain.guillemotleft by Plain.U;
} rlig;

table GDEF {
  GlyphClassDef [Plain.Zcaron Plain.K Plain.O Plain.N Plain.r Plain.eth Plain.H Plain.u], , [Plain.Oacute Plain.apple Plain.Ocircumflex Plain.Uacute], ;
} GDEF;
